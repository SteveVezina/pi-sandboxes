{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PI Sandbox",
  "version": "0.1.0",
  "identifier": "dev.pi-sandbox.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "PI Sandbox",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "PI Sandbox desktop workbench",
    "longDescription": "Cross-platform desktop workbench for creating, inspecting, and operating PI sandbox daemon sessions."
  }
}
